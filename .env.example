# ===== WDC App Environment Config =====
# Copy this file to .env and fill values.
# If USE_FIREBASE=false, the app uses local JSON storage (great for college demos).

USE_FIREBASE=false

# Path to Firebase service account key JSON (only needed if USE_FIREBASE=true)
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json

# Firebase web config (used by frontend SDK for browser push). Leave blank in local mode.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# JWT
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=12

# Admin bootstrap (created by seed_data.py if absent)
DEFAULT_SUPER_ADMIN_EMAIL=admin@wdc.edu
DEFAULT_SUPER_ADMIN_PASSWORD=Admin@123

# Email (notifications). Stub mode prints to console if SMTP_HOST is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=wdc-noreply@example.local

# CORS
CORS_ORIGINS=*
